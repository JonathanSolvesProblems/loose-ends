# --- Loose Ends configuration -------------------------------------------------
# Copy this file to `.env` and fill in real values. Nothing here is committed.
# The agent reads every value at startup; there are no secrets in source.

# --- The AI judgment layer (bring-your-own-model; the challenge mandates no
#     specific vendor). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Which model classifies request-vs-commitment and verifies completion evidence.
# gpt-4o-mini is fast and cheap for high-volume message classification. Override
# for higher accuracy (gpt-4o, ...).
# LOOSE_ENDS_MODEL=gpt-4o-mini

# Optional: point at any OpenAI-compatible endpoint for a fully-local, zero-cost
# model (Ollama, LM Studio). When set, no cloud key is required.
# LOOSE_ENDS_LLM_BASE_URL=http://localhost:11434/v1

# --- Slack app credentials ----------------------------------------------------
# Create an app from manifest.json at https://api.slack.com/apps, install it to
# your developer sandbox, then copy these three values in.
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information -> App-Level Tokens (connections:write)
SLACK_SIGNING_SECRET=...          # Basic Information -> Signing Secret

# --- Scope + routing ----------------------------------------------------------
# Opt-in only: comma-separated channel IDs the agent is allowed to watch. The
# bot must also be /invite-d into each one. Empty = watch every channel it is in.
LOOSE_ENDS_CHANNELS=

# The backup human. Unowned requests that nobody claims, and commitments that go
# past their grace, escalate here. Use a Slack user ID (e.g. U0123ABCD).
LOOSE_ENDS_COORDINATOR=

# Optional: a Slack List to write claimed/approved follow-ups into (system of
# record). Requires a paid workspace with Lists enabled; leave blank to skip.
LOOSE_ENDS_LIST_ID=

# Workspace timezone offset in minutes from UTC, used to ground deadlines like
# "by Friday" / "EOD". e.g. -240 for US Eastern in summer, 540 for JST.
LOOSE_ENDS_TZ_OFFSET=0

# Set to 1 for the demo: shrinks the SLA/grace timers from hours to ~15s each so
# escalations and breaks are visible live on camera. Leave unset in production.
LOOSE_ENDS_DEMO=
